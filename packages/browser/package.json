{
  "name": "@bearlyai/seda-browser",
  "version": "0.3.1",
  "description": "Private, in-browser speech recognition for Seda using WebGPU or WASM",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-worker.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@bearlyai/seda": "^0.3.1"
  },
  "devDependencies": {
    "@bearlyai/seda": "workspace:*",
    "@huggingface/transformers": "4.2.0",
    "@webgpu/types": "0.1.69",
    "esbuild": "0.28.1",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bearlyai/seda.git",
    "directory": "packages/browser"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
