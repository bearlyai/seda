{
  "name": "@bearlyai/seda-node",
  "version": "0.1.0",
  "description": "Lifecycle-managed Seda sidecar for Node and Electron",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bearlyai/seda": "workspace:*",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bearlyai/seda.git",
    "directory": "packages/node"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
