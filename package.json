{
  "name": "seda-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @bearlyai/seda build && pnpm --filter @bearlyai/seda-node build",
    "check": "pnpm --filter @bearlyai/seda check && pnpm --filter @bearlyai/seda build && pnpm --filter @bearlyai/seda-node check && tsc -p tsconfig.browser.json",
    "test": "pnpm --recursive test",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3"
  }
}
